#include <winver.h>

1 ICON "@ICON@"
1 24 "@MANIFEST@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VERSION_COMMAS@,0
PRODUCTVERSION @VERSION_COMMAS@,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Mantice"
      VALUE "FileDescription", "Mantice text expander"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "mantice"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "mantice.exe"
      VALUE "ProductName", "Mantice"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
